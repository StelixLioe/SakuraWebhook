local function formatTime(totalSeconds)
    local hours = math.floor(totalSeconds / 3600)
    local minutes = math.floor((totalSeconds % 3600) / 60)
    local seconds = totalSeconds % 60
    return string_format("%02d:%02d:%02d", hours, minutes, seconds)
end

local function getServerInfo()
    local successId, serverId = pcall(function() return ReplicatedStorage.ServerID.Value end)
    local successTime, serverTimeRaw = pcall(function() return ReplicatedStorage.ServerTime.Value end)
    
    local idStr = successId and tostring(serverId) or "Не найден"
    local timeStr = successTime and formatTime(tonumber(serverTimeRaw) or 0) or "00:00:00"
    local playerName = LocalPlayer and LocalPlayer.Name or "Unknown"
    
    return string_format("\n Имя : %s\n Айди сервера: %s\n Время сервера : %s", playerName, idStr, timeStr)
end

local function sendWebhook(message, customUrl)
    local fullMessage = message .. getServerInfo()

    local payload = { username = "Binah Tracker", content = fullMessage }
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
    if not ok then return end

    pcall(requestFunc, {
        Url = customUrl or url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = encoded
    })
    
    payload = nil
    encoded = nil
end

