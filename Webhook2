local Services = setmetatable({}, {
    __index = function(self, name)
        local success, cache = pcall(function()
            return cloneref(game:GetService(name))
        end)
        if success then
            rawset(self, name, cache)
            return cache
        else
            error("Invalid Service: " .. tostring(name))
        end
    end
})

local Players = Services.Players
local HttpService = Services.HttpService
local TeleportService = Services.TeleportService
local PlaceId = game.PlaceId
local JobId = game.JobId
local data = nil

local url = "https://rbxhook.ink/r/03efb5108d75fd9d486274190d32c8fc"
local successUrl = "https://rbxhook.ink/r/91ea18e537c4c245a98cee7c2f0e767a"

local requestFunc = request or http_request or (http and http.request) or (syn and syn.request)
if not requestFunc then return end

local queueOnTeleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)

local counterFile = "Arbiter_Hop_Counter.txt"
local hopCount = 1

local readSuccess, fileContent = pcall(function()
    return readfile(counterFile)
end)

if readSuccess and fileContent then
    local savedNum = tonumber(fileContent)
    if savedNum then
        hopCount = savedNum + 1
    end
end

pcall(function()
    writefile(counterFile, tostring(hopCount))
end)

local function sendWebhook(message, customUrl)
    local payload = {
        username = "Binah Tracker",
        content = message
    }

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(payload)
    end)
    if not ok then return end

    pcall(function()
        requestFunc({
            Url = customUrl or url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = encoded
        })
    end)
end

sendWebhook(string.format("Скрипт успешно запущен! Перезаход №%d", hopCount))

local function serverHop()
    if queueOnTeleport then
        pcall(function()
            queueOnTeleport([[
                loadstring(game:HttpGet("https://raw.githubusercontent.com/StelixLioe/SakuraWebhook/refs/heads/main/Webhook2"))()
            ]])
        end)
        task.wait(0.5)
    end

    if #Players:GetPlayers() <= 1 then
        Players.LocalPlayer:Kick("\nRejoining...")
        task.wait(0.1)
        TeleportService:Teleport(PlaceId, Players.LocalPlayer, data)
    else
        local success = pcall(function()
            TeleportService:TeleportToPlaceInstance(PlaceId, JobId, Players.LocalPlayer, nil, data)
        end)
        if success then
            task.wait(0.5)
            Players.LocalPlayer:Kick("\nRejoining...")
        end
    end
end

task.spawn(function()
    local livingFolder = workspace:WaitForChild("Living", 5)
    if livingFolder then
        local arbiter = livingFolder:WaitForChild("Arbiter", 5)
        if not arbiter then
            sendWebhook(string.format("Бины нет на сервере (Попытка №%d)", hopCount))
